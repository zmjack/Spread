<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Authors>zmjack</Authors>
    <Company>linqsharp.net</Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.0.13-alpha</Version>
    <Description>Smart spreadsheet creation library.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/zmjack/Spread</RepositoryUrl>
    <PackageProjectUrl>https://github.com/zmjack/Spread</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © linqsharp.net 2023</Copyright>
    <PackageId>Spread</PackageId>
    <PackageTags>Spreadsheet</PackageTags>
    <PackageIconUrl />
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net7.0|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net7.0|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="Core\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="6.0.1" />
    <PackageReference Include="NStandard" Version="0.75.0" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Form\SpreadFormHelper.Date.cs">
      <DependentUpon>SpreadFormHelper.Date.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Form\SpreadFormHelper.Percent.cs">
      <DependentUpon>SpreadFormHelper.Percent.tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Form\SpreadFormHelper.Number..cs">
      <DependentUpon>SpreadFormHelper.Number..tt</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Form\SpreadFormHelper.DateTime.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SpreadFormHelper.DateTime.tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Form\SpreadFormHelper.Date.tt">
      <LastGenOutput>SpreadFormHelper.Date.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="Form\SpreadFormHelper.Percent.tt">
      <LastGenOutput>SpreadFormHelper.Percent.cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="Form\SpreadFormHelper.Number..tt">
      <LastGenOutput>SpreadFormHelper.Number..cs</LastGenOutput>
      <Generator>TextTemplatingFileGenerator</Generator>
    </None>
    <None Update="Form\SpreadFormHelper.DateTime.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>SpreadFormHelper.DateTime.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
