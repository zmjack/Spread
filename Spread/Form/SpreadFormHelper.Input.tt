<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
using System.Linq.Expressions;
using System.Runtime.CompilerServices;

namespace Spread.Form;

public partial class SpreadFormHelper<TEntity>
{
<#
    foreach(var type in new[]
    {
        "short", "short?",
        "int", "int?",
        "long", "long?",
        "float", "float?",
        "double", "double?",
        "decimal", "decimal?",
    })
    {
#>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public SpreadFormValue Number(Expression<Func<TEntity, <#=type#>>> selector, SpreadFormRule? rule = null) => InnerValue(selector, UIComponent.Number, rule);
<#
    }
#>

<#
    foreach(var type in new[]
    {
        "float", "float?",
        "double", "double?",
        "decimal", "decimal?",
    })
    {
#>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public SpreadFormValue Percent(Expression<Func<TEntity, <#=type#>>> selector, SpreadFormRule? rule = null) => InnerValue(selector, UIComponent.Percent, rule);
<#
    }
#>

<#
    foreach(var type in new[]
    {
        "DateOnly", "DateOnly?",
    })
    {
#>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public SpreadFormValue Date(Expression<Func<TEntity, <#=type#>>> selector, SpreadFormRule? rule = null) => InnerValue(selector, UIComponent.Date, rule);
<#
    }
#>

<#
    foreach(var type in new[]
    {
        "DateTime", "DateTime?",
        "DateTimeOffset", "DateTimeOffset?",
    })
    {
#>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public SpreadFormValue DateTime(Expression<Func<TEntity, <#=type#>>> selector, SpreadFormRule? rule = null) => InnerValue(selector, UIComponent.DateTime, rule);
<#
    }
#>

}
